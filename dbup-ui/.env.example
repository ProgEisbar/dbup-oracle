# En desarrollo se recomienda dejarla vacía: Vite usa el proxy configurado
# abajo y el navegador llama rutas relativas (/auth y /api).
VITE_API_URL=

# Ruta publica del frontend. Usar / si se publica en la raiz, o por ejemplo
# /dbup-ui/ cuando se sirve bajo un subdirectorio.
VITE_PUBLIC_BASE=/

# Servidor local del frontend
DEV_SERVER_HOST=localhost
DEV_SERVER_PORT=5173

# Destino del proxy local. No se expone al bundle del navegador.
BACKEND_PROXY_TARGET=http://localhost:3001

# Preview del build (opcional)
PREVIEW_SERVER_HOST=localhost
PREVIEW_SERVER_PORT=4173
